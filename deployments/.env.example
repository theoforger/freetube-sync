# Copy this file to .env and fill in real values before running
# `docker compose up -d`. Never commit the resulting .env.

# Required: a long random secret shared between the server and every
# client's --token / FREETUBE_SYNC_TOKEN. Generate one with:
#   openssl rand -hex 32
TOKEN=changeme

# Optional: the port freetube-sync listens on inside its container. Used
# by both compose files. compose.yaml also publishes it directly on the
# host; compose.caddy.yaml keeps it internal and has Caddy proxy to it.
LISTEN_PORT=8080

# Optional: only used by compose.caddy.yaml. Set this to your real public
# domain to get automatic HTTPS from Caddy; defaults to "localhost".
DOMAIN=localhost
