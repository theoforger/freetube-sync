# Copy this file to .env and fill in real values before running
# `docker compose up -d`. Never commit the resulting .env.

# Required: a long random secret shared between the server and every
# client's --token / FREETUBE_SYNC_TOKEN. Generate one with:
#   openssl rand -hex 32
TOKEN=changeme

# Optional: host port to publish. Only used by the default
# docker-compose.yml (the Caddy overlay publishes 80/443 instead).
LISTEN_PORT=8080

# Optional: only used by docker-compose.caddy.yml. Set this to your real
# public domain to get automatic HTTPS from Caddy; defaults to "localhost".
DOMAIN=localhost
